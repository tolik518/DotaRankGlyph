<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required to drive the Glyph Matrix -->
    <uses-permission android:name="com.nothing.ketchum.permission.ENABLE" />
    <!-- OpenDota API -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DotaRankGlyph">

        <!-- Not required on Phone (3), but the official example ships it; harmless. -->
        <meta-data
            android:name="NothingKey"
            android:value="test" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />

        <!-- Launcher entries: exactly one is enabled. The default shows the Immortal medal;
             with "App icon shows my medal" on, LauncherIcon enables the one for the current medal. -->
        <activity-alias
            android:name=".ui.Launcher"
            android:exported="true"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".ui.LauncherHerald"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_herald"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".ui.LauncherGuardian"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_guardian"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".ui.LauncherCrusader"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_crusader"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".ui.LauncherArchon"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_archon"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".ui.LauncherLegend"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_legend"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".ui.LauncherAncient"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_ancient"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".ui.LauncherDivine"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_divine"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- "Share" a Steam profile to the app. A separate component, so the setting
             "Show in the share menu" can disable it without touching the launcher entry. -->
        <activity-alias
            android:name=".ui.ShareTarget"
            android:exported="true"
            android:label="@string/share_label"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

        <!-- The Glyph Toy -->
        <service
            android:name=".toy.DotaRankToyService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="com.nothing.glyph.TOY" />
            </intent-filter>

            <meta-data
                android:name="com.nothing.glyph.toy.name"
                android:resource="@string/toy_name" />
            <meta-data
                android:name="com.nothing.glyph.toy.image"
                android:resource="@drawable/toy_preview" />
            <meta-data
                android:name="com.nothing.glyph.toy.summary"
                android:resource="@string/toy_summary" />
            <!-- Opens the settings screen from the Glyph Toys manager -->
            <meta-data
                android:name="com.nothing.glyph.toy.introduction"
                android:value="com.glyphrank.dota.ui.MainActivity" />
            <!-- Long-press the Glyph Button = refresh -->
            <meta-data
                android:name="com.nothing.glyph.toy.longpress"
                android:value="1" />
            <!-- Can be picked as the Always-on Glyph Toy (EVENT_AOD every minute) -->
            <meta-data
                android:name="com.nothing.glyph.toy.aod_support"
                android:value="1" />
        </service>

    </application>

</manifest>
